# What the form back end reads. The real file is created by `npm run env` as
# .env.<domain> (e.g. .env.promo.abect.com) — empty, with notes on where to
# get each value.
#
# Locally: the filled file sits at the project root (server/form.php reads it
# during npm run dev).
# On the hosting: it goes into a secrets folder ONE LEVEL ABOVE public_html:
#   /home/<user>/secrets/.env.<domain>
# NEVER inside public_html or dist/, NEVER committed to git.

# From @BotFather, looks like 123456789:AA…
TELEGRAM_BOT_TOKEN=
# From getUpdates, groups start with -100
CHAT_ID=
