# Example of the form back end credentials. The real file is created by
# `npm run env` as .env.<domain> (e.g. .env.promo.abect.com) with empty values.
#
# Locally: the filled file sits at the project root (server/form.php reads it
# during npm run dev).
# On the hosting: it goes into a secrets folder ONE LEVEL ABOVE public_html:
#   /home/<user>/secrets/.env.<domain>
# NEVER inside public_html or dist/, NEVER committed to git.
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
CHAT_ID=-1000000000000
