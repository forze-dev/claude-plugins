# Apache configuration for the built site.
#
# `npm run build` generates this file from server/htaccess.template — edit the
# template, not dist/.htaccess. Upload limits are substituted from
# SITE.form.maxFileMb in src/site.config.js.
#
# Upload the CONTENTS of dist/ into public_html; this file goes along with it.

RewriteEngine On

# --- HTTPS and the canonical host ---------------------------------------------
# One redirect to https://domain-without-www for both cases: an HTTP request and
# a www request. The domain is captured, not hard-coded.
#
# REQUIRES an SSL certificate on the domain (on cPanel — AutoSSL, usually on).
# Without it the site would redirect to an https that doesn't exist. If the site
# is behind Cloudflare in "Flexible" mode, replace the HTTPS condition with
# `RewriteCond %{HTTP:X-Forwarded-Proto} !https`, or you get an endless redirect.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --- Canonical addresses -----------------------------------------------------
# /index.html -> /   and   /privacy-policy.html -> /privacy-policy
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Clean address -> the file behind it --------------------------------------
# A generic rule for any page added later. The -f condition guarantees a
# non-existent address honestly returns 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --- Protecting credentials --------------------------------------------------
# `Require` is Apache 2.4 syntax. Hosts on 2.2 practically no longer exist in
# 2026; if you meet one, replace it with `Order allow,deny` + `Deny from all`.
#
# .env must sit ONE LEVEL ABOVE public_html. This is a safety net in case it
# ends up inside anyway.
<FilesMatch "^\.(env|env\..*)$">
	Require all denied
</FilesMatch>

# The PHP back end reads its limits from disk, not over HTTP.
<Files "form.limits.json">
	Require all denied
</Files>

# --- Upload sizes for the PHP back end ----------------------------------------
# Typical shared-hosting values are 2M or 8M. Without this, PHP itself rejects
# a large file before form.php ever runs.
#
# On some hosts php_value in .htaccess is IGNORED (PHP-FPM, CGI) — there it can
# only be changed in the panel: cPanel → MultiPHP INI Editor. The blocks are
# wrapped in IfModule because on PHP-FPM an unknown directive would take the
# whole site down with a 500.
<IfModule mod_php.c>
	php_value upload_max_filesize __UPLOAD_MAX__
	php_value post_max_size __POST_MAX__
</IfModule>
<IfModule mod_php7.c>
	php_value upload_max_filesize __UPLOAD_MAX__
	php_value post_max_size __POST_MAX__
</IfModule>
<IfModule mod_php8.c>
	php_value upload_max_filesize __UPLOAD_MAX__
	php_value post_max_size __POST_MAX__
</IfModule>

<IfModule mod_headers.c>
	# Covers both /thank-you and /thank-you.html — the match is on the served file.
	<FilesMatch "^thank-you\.html$">
		Header set X-Robots-Tag "noindex, nofollow"
	</FilesMatch>

	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set X-Frame-Options "SAMEORIGIN"

	# HSTS: one year. `includeSubDomains` is deliberately absent: shared hosting
	# often has a subdomain without a certificate (cpanel., webmail., mail.), and
	# the directive would lock it out for good in every browser. `preload` even
	# more so: it is practically irreversible.
	Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

	Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
</IfModule>

# --- No directory listings ---------------------------------------------------
Options -Indexes

# --- Caching -----------------------------------------------------------------
# Astro hashes everything in /_astro/, so it can be cached for a long time.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/jpeg "access plus 1 month"
	ExpiresByType image/webp "access plus 1 month"
	# Fonts are self-hosted. Their names have NO hash, so rename a file when you replace it.
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json application/manifest+json
</IfModule>

# A real 404 page with a 404 status.
ErrorDocument 404 /404.html
