---
/**
 * Privacy policy — a DRAFT for a lawyer, not legal advice.
 *
 * The text states only what the site provably does (from the config and the
 * code) and avoids commitments nobody has made: no retention periods, no
 * response deadlines, no legal bases. Those depend on the client's
 * jurisdiction and practice — the agent asks for them or leaves the neutral
 * wording; it never invents a number.
 *
 * `data-demo-content` on the body keeps `npm run check` red until the text has
 * been rewritten for the client and the site language. Remove it only then.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, formatAddress } from '../site.config.js';
import { webPage, breadcrumbs } from '../lib/schema.js';

import '../styles/pages/privacy.css';

const title = 'Privacy Policy';
const description =
	'How we collect, use, store and delete the personal data you submit through the request form, and the rights you have over it.';

const trail = [
	{ label: SITE.ui.home, href: '/' },
	{ label: 'Privacy policy' },
];

/** The date the text was last changed — set it when you edit the policy. */
const updated = '2026-10-17';
const updatedLabel = '17 October 2026';

const { email, phones } = SITE.contacts;
const postal = formatAddress();

/**
 * Section 8 must match what the site DOES, not what we'd like it to do — so it
 * asks the config about trackers instead of guessing.
 */
const analyticsEnabled = Boolean(SITE.analytics.gtmId || SITE.analytics.gaId);
const analyticsName = SITE.analytics.gtmId ? 'Google Tag Manager' : 'Google Analytics 4';

const schema = [
	{ ...webPage('/privacy-policy', { name: title, description }), dateModified: updated },
	breadcrumbs(trail),
];
---

<Base title={title} description={description} type="article" schema={schema}>
	<Breadcrumbs trail={trail} />

	<section class="section--tight">
		<div class="container privacy">
			<header class="privacy__head">
				<h1>Privacy policy</h1>
				<p class="privacy__updated">Last updated: <time datetime={updated}>{updatedLabel}</time></p>
				<p class="lead">
					This page explains what personal data we collect through this website, why we collect it and
					what rights you have over it.
				</p>
			</header>

			<div class="prose privacy__body" data-demo-content>
				<section class="privacy__section">
					<h2>1. Who we are</h2>
					<p>
						This website is operated by {SITE.name} ("we", "us"). You can reach us at
						<a href={`mailto:${email}`}>{email}</a>{postal && <> or by post at {postal}</>}. We decide how
						and why your personal data is processed.
					</p>
				</section>

				<section class="privacy__section">
					<h2>2. What we collect</h2>
					<p>We only collect what the request form asks for, plus a small amount of technical data:</p>
					<ul>
						<li>Your name and phone number, because we cannot answer a request without them.</li>
						<li>The message you write, and any file you choose to attach.</li>
						<li>The page you submitted from, so we know what the request refers to.</li>
						<li>Your IP address, used only to rate-limit submissions and block automated abuse.</li>
					</ul>
					<p>
						We do not ask for payment details, government identifiers or health information, and you
						should not send them through this form.
					</p>
				</section>

				<section class="privacy__section">
					<h2>3. Why we use it</h2>
					<p>
						We use your data to reply to your request, to prepare an offer and to keep a record of what was
						agreed.
					</p>
				</section>

				<section class="privacy__section">
					<h2>4. Who else sees it</h2>
					<p>
						Form submissions are delivered to a private Telegram chat, so Telegram processes them in
						transit. Our website is served by a hosting provider that records standard access logs. We
						do not sell your data, and we do not share it with advertisers.
					</p>
				</section>

				<section class="privacy__section">
					<h2>5. How long we keep it</h2>
					<p>
						We keep your request for as long as we need it to answer you and to carry out what was agreed,
						and for as long as the law requires us to keep business records. After that we delete it.
					</p>
				</section>

				<section class="privacy__section">
					<h2>6. How we protect it</h2>
					<p>
						The site is served over HTTPS and the form posts directly to our own server. Credentials for
						the delivery bot are stored outside the public part of the server and are never exposed to the
						browser. Attachments are passed straight through and are not stored on the web server.
					</p>
				</section>

				<section class="privacy__section">
					<h2>7. Your rights</h2>
					<p>
						You can ask us for a copy of your data, ask us to correct or delete it, or object to our using
						it. Write to <a href={`mailto:${email}`}>{email}</a>. If you are not satisfied with our
						response, you can complain to your local data protection authority.
					</p>
				</section>

				<section class="privacy__section">
					<h2>8. Cookies, analytics and third-party requests</h2>
					<p>
						We set no cookies of our own. Every font, stylesheet, script and image is served from this
						domain: the page layout itself reaches no other company.
					</p>
					{analyticsEnabled ? (
						<p>
							We do use {analyticsName}, which is provided by Google and sets cookies. It records which
							pages you open, roughly where you are from and which site sent you. A browser that blocks
							third-party scripts, or any tracker blocker, prevents it entirely.
						</p>
					) : (
						<p>We run no analytics, advertising or session-recording scripts.</p>
					)}
					{/*
						Developer note, not for visitors: if you add a chat widget, a map embed or
						any other third-party script, update this section before launch — name
						the provider, what it stores, and whether it needs consent.
					*/}
				</section>

				<section class="privacy__section">
					<h2>9. Changes to this policy</h2>
					<p>When we change this policy, we update the date at the top of this page.</p>
				</section>

				<section class="privacy__section">
					<h2>10. Contact</h2>
					<p>
						Questions about this policy, or about anything we hold on you, go to
						<a href={`mailto:${email}`}>{email}</a> or
						<a href={`tel:${phones[0].href}`}>{phones[0].display}</a>. The
						<a href="/#contacts">contacts section</a> lists every other way to reach us.
					</p>
				</section>
			</div>
		</div>
	</section>
</Base>
