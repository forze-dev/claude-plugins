---
/**
 * Каркас сторінки: head, хедер, футер, модалка й клієнтські скрипти. Сторінки
 * передають свої SEO-пропси, масив власних вузлів `schema` і наповнюють слот.
 */
import { SITE } from '../site.config.js';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RequestModal from '../components/RequestModal.astro';
import { graph, business, website } from '../lib/schema.js';

import '../styles/main.css';

const { schema, noindex = false, ...seo } = Astro.props;

/**
 * Бізнес і `WebSite` — у графі КОЖНОЇ сторінки, і додає їх layout, а не
 * сторінка: так `webPage()` ніколи не посилається на `#organization`, якого
 * в графі немає. Сторінка передає лише свої власні вузли.
 *
 * Виняток — `noindex`: закриту від індексації сторінку пошуковик не читає, тож
 * описувати їй бізнес нема кому, а розмітка все одно їде у відповідь.
 */
const jsonLd = noindex ? null : graph(business(), website(), ...[schema ?? []].flat());
---

<!DOCTYPE html>
<html lang={SITE.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<Seo {...seo} noindex={noindex} />

		{/*
			Основне накреслення — preload, бо його потребує кожен екран і воно
			впливає на LCP. Решта підтягується за unicode-range тільки якщо в
			тексті справді зустрілися ці символи. Шрифт самохостений.
		*/}
		<link rel="preload" href="/fonts/instrument-sans-latin-normal.woff2" as="font" type="font/woff2" crossorigin />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, '\t')} />}

		{/* Теги head для конкретної сторінки. */}
		<slot name="head" />
		<Analytics position="head" />
	</head>

	<body>
		<Analytics position="body" />
		<a class="skip-link" href="#main">{SITE.ui.skipLink}</a>
		<Header />

		<main id="main">
			<slot />
		</main>

		<Footer />

		<RequestModal />

		<script>
			// Збирається Astro: один запит, імʼя з хешем, довгий кеш.
			import { initHeader } from '../scripts/header.js';
			import { initFloatingBar } from '../scripts/floating-bar.js';
			import { initModal } from '../scripts/modal.js';
			import { initForms } from '../scripts/form.js';

			initHeader();
			initFloatingBar();
			initModal();
			// Вбудовані форми (секція контактів). Форму в модалці initModal
			// підключає сам при першому відкритті; повторно вона не ініціалізується.
			initForms(document.querySelector('main') ?? document);
		</script>
	</body>
</html>
