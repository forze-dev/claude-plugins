---
/**
 * The page shell: head, header, footer, modal and client scripts. Pages pass
 * their SEO props and an array of their own `schema` nodes, and fill the slot.
 */
import { SITE } from '../site.config.js';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RequestModal from '../components/RequestModal.astro';
import { graph, business, website } from '../lib/schema.js';
import { preloadFonts } from '../lib/fonts.js';

import '../styles/main.css';

const { schema, noindex = false, ...seo } = Astro.props;

/**
 * The business and `WebSite` are in the graph of EVERY page, and the layout
 * adds them, not the page: that way `webPage()` never points to an
 * `#organization` missing from the graph. A page passes only its own nodes.
 *
 * Exception — `noindex`: search engines don't read a page closed to indexing,
 * so there's no one to describe the business to, while the markup would still
 * ship in the response.
 */
const jsonLd = noindex ? null : graph(business(), website(), ...[schema ?? []].flat());
---

<!DOCTYPE html>
<html lang={SITE.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<Seo {...seo} noindex={noindex} />

		{/*
			The ranges the site's language needs are preloaded because every screen
			needs them and they affect LCP (src/lib/fonts.js). The rest load by
			unicode-range only if those characters actually appear. Self-hosted.
		*/}
		{preloadFonts().map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, '\t')} />}

		{/* Page-specific head tags. */}
		<slot name="head" />
		<Analytics position="head" />
	</head>

	<body>
		<Analytics position="body" />
		<a class="skip-link" href="#main">{SITE.ui.skipLink}</a>
		<Header />

		<main id="main">
			<slot />
		</main>

		<Footer />

		<RequestModal />

		<script>
			// Bundled by Astro: one request, a hashed name, long caching.
			import { initHeader } from '../scripts/header.js';
			import { initFloatingBar } from '../scripts/floating-bar.js';
			import { initModal } from '../scripts/modal.js';
			import { initForms } from '../scripts/form.js';

			initHeader();
			initFloatingBar();
			initModal();
			// Embedded forms (the contacts section). initModal wires the modal's form
			// itself on first open; it is never initialized twice.
			initForms(document.querySelector('main') ?? document);
		</script>
	</body>
</html>
