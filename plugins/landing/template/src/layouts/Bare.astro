---
/**
 * A minimal shell for standalone screens without the site chrome: the
 * thank-you page and the 404. It is a separate layout because Astro hoists
 * <script> tags globally: a condition inside Base would still ship these pages
 * the code for the header, modal and floating bar they don't have.
 *
 * Both pages are `noindex`, so they carry no structured data at all — neither
 * JSON-LD nor business microdata.
 */
import { SITE } from '../site.config.js';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import { graph, business, website } from '../lib/schema.js';

import '../styles/main.css';

const { schema, noindex = false, ...seo } = Astro.props;

/** The same base graph as in `Base`, should an indexed page ever appear here. */
const jsonLd = noindex ? null : graph(business(), website(), ...[schema ?? []].flat());
---

<!DOCTYPE html>
<html lang={SITE.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Seo {...seo} noindex={noindex} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, '\t')} />}
		<link rel="preload" href="/fonts/instrument-sans-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
		<Analytics position="head" />
	</head>
	<body>
		<Analytics position="body" />
		<slot />
	</body>
</html>
