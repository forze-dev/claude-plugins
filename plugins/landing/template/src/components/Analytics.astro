---
/**
 * Third-party analytics scripts.
 *
 * The scaffold has none. Set an id in `analytics` in site.config.js and the
 * snippet appears **only in the production build**, so `npm run dev` doesn't
 * pollute the analytics with your own clicks.
 *
 * The layout renders the component twice: once in <head>, once right after
 * <body> (Google Tag Manager needs both halves).
 *
 * The snippets are assembled as strings here rather than written into the
 * markup: the GTM loader is full of curly braces, and Astro's template parser
 * trips over them inside an attribute expression.
 *
 * `is:inline` is mandatory — without it Astro tries to bundle them, while a
 * third-party loader must run as is.
 *
 * If you work in the EU, loading trackers before consent is on you: the
 * scaffold deliberately ships no consent banner.
 */
import { SITE } from '../site.config.js';

const { position = 'head' } = Astro.props;
const { gtmId, gaId } = SITE.analytics ?? {};

// Never load trackers in dev or preview.
const live = import.meta.env.PROD;

const showGtmHead = live && position === 'head' && Boolean(gtmId);
const showGtmBody = live && position === 'body' && Boolean(gtmId);
// Tag Manager already contains GA4, so the direct tag is only for sites without GTM.
const showGa = live && position === 'head' && Boolean(gaId) && !gtmId;

const gtmHead =
	"(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});" +
	"var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;" +
	"j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})" +
	"(window,document,'script','dataLayer','" + gtmId + "');";

const gtmBody =
	'<iframe src="https://www.googletagmanager.com/ns.html?id=' + gtmId +
	'" height="0" width="0" style="display:none;visibility:hidden"></iframe>';

const gaInit =
	'window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}' +
	"gtag('js',new Date());gtag('config','" + gaId + "');";

const gaSrc = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
---

{showGtmHead && <script is:inline set:html={gtmHead} />}

{/*
	The closing tag is mandatory, and not for style. `<noscript>` is a raw-text
	element: the HTML parser does NOT treat `<noscript … />` as self-closing, so
	everything below it in the template becomes its content. While the condition
	is true this is barely visible; once it is false, all the component's later
	output disappears together with the noscript. That is exactly why GA4 once
	never reached the build: its block sits below this line.
*/}
{showGtmBody && <noscript set:html={gtmBody}></noscript>}

{showGa && (
	<Fragment>
		<script is:inline async src={gaSrc}></script>
		<script is:inline set:html={gaInit} />
	</Fragment>
)}
