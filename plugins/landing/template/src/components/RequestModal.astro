---
/**
 * Модалка заявки. Layout рендерить її один раз на сторінку і тримає прихованою,
 * доки не натиснуть тригер [data-modal-open] — тож це справжній HTML, а не рядок
 * усередині скрипта.
 */
import { SITE } from '../site.config.js';
import RequestForm from './RequestForm.astro';

const { ui } = SITE;
---

<div class="modal-overlay" data-modal hidden>
	<div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
		<button class="modal__close" type="button" data-modal-close aria-label={ui.close}>
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
		</button>

		<h2 class="modal__title" id="modal-title">{ui.modalTitle}</h2>
		<p class="modal__subtitle">{ui.modalSubtitle}</p>

		<RequestForm id="modal" />

		<p class="modal__contacts">
			{ui.modalPreferToTalk}
			{SITE.contacts.phones.map((phone) => <a href={`tel:${phone.href}`}>{phone.display}</a>)}
		</p>
	</div>
</div>
