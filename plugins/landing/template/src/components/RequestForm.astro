---
/**
 * The request form. Used in two places: embedded in the landing's contacts
 * section and inside the modal. Both render this same component, so the
 * markup exists exactly once.
 *
 * `id` must differ for every instance on the page — field ids are built from
 * it, and `npm run check` catches duplicate ids.
 */
import { SITE, fillMessage } from '../site.config.js';

const { id = 'form', showNote = false } = Astro.props;
const { ui } = SITE;
const phonePlaceholder = SITE.form.phone.placeholder ?? SITE.contacts.phones[0].display;
const accept = SITE.form.allowedExtensions.map((extension) => `.${extension}`).join(',');
/** The consent sentence around the link — `{link}` keeps word order natural in any language. */
const [consentBefore, consentAfter = ''] = ui.formConsent.split('{link}');
---

<form class="form" data-form novalidate>
	<div class="form__field">
		<label class="form__label" for={`${id}-name`}>{ui.formName}</label>
		<input class="form__input" id={`${id}-name`} name="username" type="text" autocomplete="name" required />
	</div>

	<div class="form__field">
		<label class="form__label" for={`${id}-phone`}>{ui.formPhone}</label>
		<input
			class="form__input"
			id={`${id}-phone`}
			name="phone"
			type="tel"
			autocomplete="tel"
			placeholder={phonePlaceholder}
			required
		/>
	</div>

	<div class="form__field">
		<label class="form__label" for={`${id}-comment`}>{ui.formComment}</label>
		<textarea
			class="form__input form__textarea"
			id={`${id}-comment`}
			name="comment"
			rows="3"
			placeholder={ui.formCommentPlaceholder}></textarea>
	</div>

	<div class="form__file">
		<button class="form__file-trigger" type="button" data-file-trigger>
			<img src="/assets/icons/attach.svg" alt="" width="18" height="18" aria-hidden="true" />
			{ui.formAttach}
		</button>
		<input class="visually-hidden" type="file" name="drawing" data-file-input accept={accept} tabindex="-1" />
		<div class="form__file-preview" data-file-preview hidden>
			<img src="/assets/icons/attached-file.svg" alt="" width="18" height="18" aria-hidden="true" />
			<span class="form__file-name" data-file-name></span>
			<span class="form__file-size" data-file-size></span>
			<button class="form__file-remove" type="button" data-file-remove aria-label={ui.formRemoveFile}>
				<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
					<path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>

	{/*
		Honeypot: moved off-screen for people, an ordinary field for a bot. The
		"Company" label is deliberately not localized: it is aria-hidden and never
		seen, and an English field name is what form-filling bots look for.
	*/}
	<div class="form__trap" aria-hidden="true">
		<label>Company<input type="text" name="company" data-form-trap tabindex="-1" autocomplete="off" /></label>
	</div>
	<input type="hidden" name="elapsedMs" value="" />

	<p class="form__message" data-form-message role="alert" aria-live="polite" hidden></p>

	<button class="btn btn--primary btn--block" type="submit">{ui.formSubmit}</button>

	{showNote && (
		<p class="form__note">
			{fillMessage(SITE.messages.fileNote)} {consentBefore}<a href="/privacy-policy">{ui.privacyLink}</a>{consentAfter}
		</p>
	)}
</form>
