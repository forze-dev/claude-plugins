---
/**
 * A question list on <details> — works without JavaScript.
 *
 * The page passes the same `entries` array to `faqPage()` for JSON-LD, and here
 * it is rendered as FAQPage microdata. An answer may contain simple HTML
 * (<a>, <strong>); the JSON-LD helper strips the tags itself.
 */
const { entries } = Astro.props;
---

<div class="faq" itemscope itemtype="https://schema.org/FAQPage">
	{entries.map((entry) => (
		<details class="faq__item" itemprop="mainEntity" itemscope itemtype="https://schema.org/Question">
			<summary class="faq__question">
				<span itemprop="name">{entry.question}</span>
				<span class="faq__marker" aria-hidden="true"></span>
			</summary>
			<div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
				<p class="faq__answer" itemprop="text" set:html={entry.answer}></p>
			</div>
		</details>
	))}
</div>
