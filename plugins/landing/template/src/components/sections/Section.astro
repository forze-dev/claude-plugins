---
/**
 * Landing section wrapper: anchor, vertical rhythm, heading and subheading.
 *
 * `id` is the anchor the menu points to (`SITE.nav`). Changed the id — change
 * the href in the config too, or the menu item leads nowhere.
 *
 * `surface` — a tinted band. Alternate it between neighbouring sections so the
 * page doesn't merge into one white wall.
 */
const { id, title, lead, surface = false, tight = false } = Astro.props;
const classes = ['section', surface && 'section--surface', tight && 'section--tight'].filter(Boolean).join(' ');
---

<section class={classes} id={id} aria-labelledby={title ? `${id}-title` : undefined}>
	<div class="container">
		{title && (
			<div class="section-head">
				<h2 id={`${id}-title`}>{title}</h2>
				{lead && <p>{lead}</p>}
			</div>
		)}
		<slot />
	</div>
</section>
