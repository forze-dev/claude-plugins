---
/**
 * Обгортка секції лендингу: якір, вертикальний ритм, заголовок і підзаголовок.
 *
 * `id` — це якір, на який веде меню (`SITE.nav`). Змінив id — зміни й href у
 * конфізі, інакше пункт меню нікуди не приведе.
 *
 * `surface` — тінтована смуга. Чергуй її між сусідніми секціями, щоб сторінка
 * не зливалася в одну білу стіну.
 */
const { id, title, lead, surface = false, tight = false } = Astro.props;
const classes = ['section', surface && 'section--surface', tight && 'section--tight'].filter(Boolean).join(' ');
---

<section class={classes} id={id} aria-labelledby={title ? `${id}-title` : undefined}>
	<div class="container">
		{title && (
			<div class="section-head">
				<h2 id={`${id}-title`}>{title}</h2>
				{lead && <p>{lead}</p>}
			</div>
		)}
		<slot />
	</div>
</section>
