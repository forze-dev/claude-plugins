---
/**
 * A card grid — advantages, services, "who it's for". One section for three
 * purposes: only the data differs.
 *
 * `items`: { title, body, price?, icon? }
 *   body  — may contain simple HTML (<strong>, <a>)
 *   price — ONLY from the brief or site.config; an invented price is worse than none
 *   icon  — path to an SVG in /assets/icons/
 * `columns`: 2 or 3.
 */
import Section from './Section.astro';

import '../../styles/sections/cards.css';

const { id, title, lead, items, columns = 3, surface = false } = Astro.props;
---

<Section id={id} title={title} lead={lead} surface={surface}>
	<ul class={`grid grid--${columns} cards`} role="list">
		{items.map((item) => (
			<li class="panel card">
				{item.icon && <img class="card__icon" src={item.icon} alt="" width="32" height="32" aria-hidden="true" />}
				<h3>{item.title}</h3>
				<p set:html={item.body}></p>
				{item.price && <p class="card__price">{item.price}</p>}
			</li>
		))}
	</ul>
</Section>
