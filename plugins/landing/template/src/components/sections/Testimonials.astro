---
/**
 * Customer reviews.
 *
 * ONLY real reviews from the client's materials, with a name the client
 * allowed to show. An invented review is an invented fact (rule 4), and a
 * legal risk for the business too. No reviews — simply don't use the section.
 *
 * No structured data here on purpose: reviews a business publishes about
 * itself on its own site are not shown by Google as rich results, and a Review
 * without signs of independence is a spam signal, not a trust signal.
 *
 * `items`: { quote, author, role? }
 */
import Section from './Section.astro';

import '../../styles/sections/testimonials.css';

const { id, title, lead, items, surface = false } = Astro.props;
---

<Section id={id} title={title} lead={lead} surface={surface}>
	<ul class="grid grid--3 testimonials" role="list">
		{items.map((item) => (
			<li class="panel testimonial">
				<blockquote>
					<p>{item.quote}</p>
				</blockquote>
				<p class="testimonial__author">
					<strong>{item.author}</strong>
					{item.role && <span>{item.role}</span>}
				</p>
			</li>
		))}
	</ul>
</Section>
